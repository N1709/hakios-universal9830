<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.redwood.motion-wake</string>
    <key>ProgramArguments</key>
    <array><string>/redwood/bin/redwood-motiond</string><string>--daemon</string></array>
    <key>EnvironmentVariables</key>
    <dict><key>DYLD_INSERT_LIBRARIES</key><string>/redwood/lib/libredwood.dylib</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>/dev/console</string>
    <key>StandardErrorPath</key><string>/dev/console</string>
</dict>
</plist>
