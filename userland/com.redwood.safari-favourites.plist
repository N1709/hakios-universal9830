<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.redwood.safari-favourites</string>
  <key>UserName</key><string>mobile</string>
  <key>ProgramArguments</key><array><string>/redwood/bin/safari_favourites</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/var/mobile</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/dev/console</string>
  <key>StandardErrorPath</key><string>/dev/console</string>
</dict></plist>
