<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.redwood.defaults</string>
	<!-- this port's defaults on a fresh data volume, once (marker /var/root/.redwood-defaults-v1):
	     Location Services on, keyboard haptics on, Live Photo off. src/redwood-defaults.c -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/redwood-defaults</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
